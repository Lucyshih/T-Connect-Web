rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 用戶資料集合
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 沙發貼文集合
    match /couches/{couchId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // 旅伴貼文集合
    match /companions/{companionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // 地陪貼文集合
    match /locals/{localId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // 意見回饋集合
    match /feedback/{feedbackId} {
      allow read: if false; // 只有管理員可以讀取意見回饋
      allow create: if true; // 所有用戶都可以創建意見回饋
      allow update, delete: if false; // 不允許修改或刪除
    }
  }
} 
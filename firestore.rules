rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 用戶資料集合
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 沙發貼文集合
    match /couches/{couchId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // 旅伴貼文集合
    match /companions/{companionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // 地陪貼文集合
    match /locals/{localId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // 意見回饋集合
    match /feedback/{feedbackId} {
      allow read: if false; // 只有管理員可以讀取意見回饋
      allow create: if true; // 所有用戶都可以創建意見回饋
      allow update, delete: if false; // 不允許修改或刪除
    }
    
    // 聊天室集合
    match /chatrooms/{chatroomId} {
      // 讀取：只有聊天室參與者可以讀取
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // 創建：登入用戶可以創建聊天室
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
      
      // 更新：只有聊天室參與者可以更新
      allow update: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // 刪除：只有聊天室參與者可以刪除
      allow delete: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // 訊息子集合
      match /messages/{messageId} {
        // 讀取：只有聊天室參與者可以讀取訊息
        allow read: if request.auth != null && 
          get(/databases/$(database)/documents/chatrooms/$(chatroomId)).data.participants[request.auth.uid] != null;
        
        // 創建：只有聊天室參與者可以發送訊息
        allow create: if request.auth != null && 
          request.auth.uid == request.resource.data.senderId &&
          get(/databases/$(database)/documents/chatrooms/$(chatroomId)).data.participants[request.auth.uid] != null;
        
        // 更新：不允許更新訊息
        allow update: if false;
        
        // 刪除：只有訊息發送者可以刪除
        allow delete: if request.auth != null && 
          request.auth.uid == resource.data.senderId;
      }
    }
    
    // 用戶資料集合 (profiles) - 用於 Cloud Function 讀取
    match /profiles/{userId} {
      // 讀取：所有人可以讀取（用於顯示用戶資料）
      allow read: if true;
      
      // 寫入：只有用戶本人可以寫入
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // 允許 Cloud Function 更新 lastEmailSent 欄位
      allow update: if request.auth != null && 
        (request.auth.uid == userId || 
         request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    
    // 評論集合
    match /comments/{commentId} {
      // 讀取：所有人可以讀取評論
      allow read: if true;
      
      // 創建：只有登入用戶可以創建評論
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      
      // 更新：不允許更新評論
      allow update: if false;
      
      // 刪除：不允許刪除評論
      allow delete: if false;
    }
    
    // 用戶評價集合
    match /userReviews/{reviewId} {
      // 讀取：所有人可以讀取評價
      allow read: if true;
      
      // 創建：只有登入用戶可以創建評價，且不能評價自己
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.reviewerId &&
        request.auth.uid != request.resource.data.targetUserId;
      
      // 更新：不允許更新評價
      allow update: if false;
      
      // 刪除：不允許刪除評價
      allow delete: if false;
    }
  }
} 